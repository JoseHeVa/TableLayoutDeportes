<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:stretchColumns="0,1">

    <!-- Cabecera temática centrada con color de fondo -->
    <TableRow android:background="#3F51B5">
        <TextView
            android:layout_column="0"
            android:layout_span="2"
            android:text="Resultados de la Jornada"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="12dp" />
    </TableRow>

    <TableRow android:background="#DDDDDD">
        <TextView
            android:text="Equipo"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:text="Goles"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </TableRow>

    <TableRow>
        <TextView
            android:text="Real Madrid"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:text="3"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </TableRow>

    <TableRow android:background="#F2F2F2">
        <TextView
            android:text="Barcelona"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:text="2"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </TableRow>

    <TableRow>
        <TextView
            android:text="Atlético Madrid"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:text="1"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
    </TableRow>

</TableLayout>
